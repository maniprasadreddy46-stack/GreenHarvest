# Copy this file to ".env" (same folder) and fill in YOUR values.
# ".env" is git-ignored. Never commit real passwords.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=greenharvest
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# Any long random text, at least 32 characters
JWT_SECRET=change-me-to-a-long-random-text-of-32-or-more-characters
JWT_EXPIRATION_MINUTES=120

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Admin account created automatically on first start
ADMIN_EMAIL=admin@greenharvest.local
ADMIN_PASSWORD=choose-a-strong-admin-password
ADMIN_NAME=GreenHarvest Admin
